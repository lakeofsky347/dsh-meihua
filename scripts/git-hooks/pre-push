#!/bin/sh
# 问象 · 占卜 —— 推送守卫
#
# 规则：拒绝推送任何包含 video/ 内容的提交，无论是本次新增、还是历史里
# 曾经出现过（即使后来删除，blob 仍会被上传）。
#
# 启用方式（仓库级，一次即可）：git config core.hooksPath scripts/git-hooks
# 绕过方式（仅在确有必要时）：git push --no-verify
set -u
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue

	# 1) 被推送的提交改了哪些路径
	if [ "$remote_sha" = "$zero" ]; then
		range=$(git rev-list "$local_sha" --not --remotes 2>/dev/null || true)
	else
		range=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null || true)
	fi
	bad=""
	if [ -n "$range" ]; then
		bad=$(git diff-tree --no-commit-id --name-only -r --root $range -- video/ 2>/dev/null | sort -u || true)
	fi
	# 2) 被推送的树里是否残留 video/ 内容
	tree_bad=$(git ls-tree -r --name-only "$local_sha" -- video/ 2>/dev/null || true)
	if [ -n "$bad" ] || [ -n "$tree_bad" ]; then
		echo "pre-push: 拒绝推送 $remote_ref —— 提交中包含 video/ 内容：" >&2
		printf '%s\n' "$bad" "$tree_bad" | sed '/^$/d' | sort -u | head -20 | sed 's/^/  - /' >&2
		echo "  video/ 是本地宣传片工作区，请从历史中移除后再推送。" >&2
		status=1
	fi
done

exit $status
