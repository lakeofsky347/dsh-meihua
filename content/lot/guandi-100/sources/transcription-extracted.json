  },
  {
    "number": 97,
    "lines": [
      "五十功名心已灰",
      "那知富貴逼人來",
      "更行好事存方寸",
      "壽比岡陵位鼎台"
    ],
    "grade": "上上",
    "revid": 1496609,
    "title": "關聖帝君靈籤/97",
    "header": "==第97簽 上上 =="
  },
  {
    "number": 98,
    "lines": [
      "經營百出費精神",
      "南北奔馳運未新",
      "玉兔交時當得意",
      "恰如枯木再逢春"
    ],
    "grade": "中平",
    "revid": 1496610,
    "title": "關聖帝君靈籤/98",
    "header": "==第98簽 中平 =="
  },
  {
    "number": 99,
    "lines": [
      "貴人遭遇水雲鄉",
      "冷淡交情滋味長",
      "黃閣開時延故客",
      "驊騮應得驟康莊"
    ],
    "grade": "上上",
    "revid": 1496611,
    "title": "關聖帝君靈籤/99",
    "header": "==第99簽 上上 =="
  },
  {
    "number": 100,
    "lines": [
      "我本天仙雷雨師",
      "吉凶禍福我先知",
      "至誠禱祝皆靈應",
      "抽得終籤百事宜"
    ],
    "grade": "上上",
    "revid": 1496612,
    "title": "關聖帝君靈籤/100",
