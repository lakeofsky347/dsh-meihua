    "grade": "中平",
    "revid": 1496571,
    "title": "關聖帝君靈籤/59",
    "header": "==第59簽 中平 =="
  },
  {
    "number": 60,
    "lines": [
      "羨君兄弟好名聲",
      "只管謙撝莫自矜",
      "丹詔槐黃相逼近",
      "巍巍科甲兩同登"
    ],
    "grade": "上上",
    "revid": 1496572,
    "title": "關聖帝君靈籤/60",
    "header": "==第60簽 上上 =="
  },
  {
    "number": 61,
    "lines": [
      "嘯聚山林兇惡儔",
      "善良無事苦煎憂",
      "主人大笑出門去",
      "不用干戈盜賊休"
    ],
    "grade": "中平",
    "revid": 1496573,
    "title": "關聖帝君靈籤/61",
    "header": "==第61簽 中平 =="
  },
  {
    "number": 62,
    "lines": [
      "百千人面虎狼心",
      "賴汝干戈用力深",
      "得勝回時秋漸老",
      "虎頭城裏喜相尋"
    ],
    "grade": "中平",
    "revid": 1496574,
    "title": "關聖帝君靈籤/62",
    "header": "==第62簽 中平 =="
  },
  {
    "number": 63,
    "lines": [
      "曩時敗北且圖南",
      "筋力雖衰尚一堪",
      "欲識生前君大數",
      "前三三與後三三"
    ],
    "grade": "中平",
    "revid": 1496575,
    "title": "關聖帝君靈籤/63",
    "header": "==第63簽 中平 =="
  },
  {
    "number": 64,
    "lines": [
      "吉人相遇本和同",
      "況有持謀天水翁",
      "人力不勞公論協",
      "事成功倍笑談中"
    ],
    "grade": "上上",
    "revid": 1496576,
    "title": "關聖帝君靈籤/64",
    "header": "==第64簽 上上 =="
  },
  {
    "number": 65,
    "lines": [
      "朔風凜凜正窮冬",
      "多羨門庭喜氣濃",
      "更入新春人事後",
      "衷言方得信先容"
    ],
    "grade": "上上",
    "revid": 1496577,
    "title": "關聖帝君靈籤/65",
    "header": "==第65簽 上上 =="
  },
  {
    "number": 66,
    "lines": [
      "耕耘只可在鄉邦",
      "何用求謀向外方",
      "見說今年新運好",
      "門闌喜氣事雙雙"
