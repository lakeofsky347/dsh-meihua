[
  {
    "number": 1,
    "lines": [
      "巍巍獨步向雲間",
      "玉殿千官第一班",
      "富貴榮華天付汝",
      "福如東海壽如山"
    ],
    "grade": "大吉",
    "revid": 2610595,
    "title": "關聖帝君靈籤/1",
    "header": "==第一籤　甲甲　大吉=="
  },
  {
    "number": 2,
    "lines": [
      "盈虛消息總天時",
      "自此君當百事宜",
      "若問前程歸縮地",
      "更須方寸好修為"
    ],
    "grade": "上吉",
    "revid": 2376270,
    "title": "關聖帝君靈籤/2",
    "header": "==第二籤　甲乙　上吉=="
  },
  {
    "number": 3,
    "lines": [
      "衣食自然生處有",
      "勸君不用苦勞心",
      "但能孝悌存忠信",
      "福祿來成禍不侵"
    ],
    "grade": "中吉",
    "revid": 2376475,
    "title": "關聖帝君靈籤/3",
    "header": "==第三籤　甲丙　中吉=="
  },
  {
    "number": 4,
    "lines": [
      "去年百事頗相宜",
      "若較今年時運衰",
      "好把瓣香告神佛",
      "莫教福謝悔無追"
    ],
    "grade": "下吉",
    "revid": 2376477,
    "title": "關聖帝君靈籤/4",
    "header": "==第四籤　甲丁　下吉=="
  },
  {
    "number": 5,
    "lines": [
      "子有三般不自由",
      "門庭蕭索冷如秋",
      "若逢牛鼠交承日",
      "萬事回春不用憂"
    ],
    "grade": "中平",
    "revid": 2376479,
    "title": "關聖帝君靈籤/5",
    "header": "==第五籤　甲戊　中平=="
  },
  {
    "number": 6,
    "lines": [
      "何勞鼓瑟更吹笙",
      "寸步如登萬里程",
      "彼此懷疑不相信",
      "休將私意憶濃情"
    ],
    "grade": "下平",
    "revid": 2376481,
    "title": "關聖帝君靈籤/6",
    "header": "==第六籤　甲己　下平=="
  },
  {
    "number": 7,
    "lines": [
      "仙風道骨本天生",
      "又遇仙宗為主盟",
      "指日丹成謝巖谷",
      "一朝引領向天行"
    ],
    "grade": "大吉",
    "revid": 2376483,
    "title": "關聖帝君靈籤/7",
    "header": "==第七籤　甲庚　大吉=="
  },
  {
    "number": 8,
    "lines": [
      "年來耕稼苦無收",
      "今歲田疇定有秋",
      "況遇太平無事日",
      "士農工賈百無憂"
    ],
    "grade": "上上",
    "revid": 2376485,
    "title": "關聖帝君靈籤/8",
    "header": "==第八籤　甲辛　上上=="
  },
  {
    "number": 9,
    "lines": [
      "望渠消息向長安",
      "常把菱花仔細看",
      "見說文書將入境",
      "今朝喜色上眉端"
    ],
    "grade": "大吉",
    "revid": 2376488,
    "title": "關聖帝君靈籤/9",
    "header": "==第九籤　甲壬　大吉=="
  },
  {
    "number": 10,
    "lines": [
      "病患時時命蹇衰",
      "何須打瓦共鑽龜",
      "宜教重見一陽復",
      "始可求神仗佛持"
    ],
    "grade": "下吉",
    "revid": 814488,
    "title": "關聖帝君靈籤/10",
    "header": "==第十籤　甲癸　下吉=="
  },
  {
    "number": 11,
    "lines": [
      "今年好事一番新",
      "富貴榮華萃汝身",
      "誰道機關難料處",
      "到頭獨立轉傷神"
    ],
    "grade": "下下",
    "revid": 1496521,
    "title": "關聖帝君靈籤/11",
    "header": "==第11簽 下下 =="
  },
  {
    "number": 12,
    "lines": [
      "營為期望在春前",
      "誰料秋來又不然",
      "直遇清江貴公子",
      "一生活計始安全"
    ],
    "grade": "中平",
    "revid": 1496522,
    "title": "關聖帝君靈籤/12",
    "header": "==第12簽 中平 =="
  },
  {
    "number": 13,
    "lines": [
      "君今庚甲未亨通",
      "且向江頭作釣翁",
      "玉兔重生應發跡",
      "萬人頭上逞英雄"
    ],
    "grade": "中平",
    "revid": 1496523,
    "title": "關聖帝君靈籤/13",
    "header": "==第13簽 中平 =="
  },
  {
    "number": 14,
    "lines": [
      "一見佳人便喜歡",
      "誰知去後有多般",
      "人情冷暖君休訝",
      "歷涉應知行路難"
    ],
    "grade": "下下",
    "revid": 1496524,
    "title": "關聖帝君靈籤/14",
    "header": "==第14簽 下下 =="
  },
  {
    "number": 15,
    "lines": [
      "兩家門戶各相當",
      "不是姻緣莫較量",
      "直待春風好消息",
      "卻調琴瑟向蘭房"
    ],
    "grade": "中平",
    "revid": 1496525,
    "title": "關聖帝君靈籤/15",
    "header": "==第15簽 中平 =="
  },
  {
    "number": 16,
    "lines": [
      "官事悠悠難辨明",
      "不如息了且歸耕",
      "傍人煽惑君休信",
      "此事當謀親弟兄"
    ],
    "grade": "下下",
    "revid": 1496526,
    "title": "關聖帝君靈籤/16",
    "header": "==第16簽 下下 =="
  },
  {
    "number": 17,
    "lines": [
      "田園價貫好商量",
      "事到公庭彼此傷",
      "縱使機關圖得勝",
      "定為後世子孫殃"
    ],
    "grade": "下下",
    "revid": 1496527,
    "title": "關聖帝君靈籤/17",
    "header": "==第17簽 下下 =="
  },
  {
    "number": 18,
    "lines": [
      "知君指擬是空華",
      "底事茫茫未有涯",
      "牢把腳根踏實地",
      "善為善應永無差"
    ],
    "grade": "中平",
    "revid": 1496528,
    "title": "關聖帝君靈籤/18",
    "header": "==第18簽 中平 =="
  },
  {
    "number": 19,
    "lines": [
      "嗟子從來未得時",
      "今年星運頗相宜",
      "營求動作都如意",
      "和合婚姻誕貴兒"
    ],
    "grade": "上吉",
    "revid": 1496529,
    "title": "關聖帝君靈籤/19",
    "header": "==第19簽 上吉 =="
  },
  {
    "number": 20,
    "lines": [
      "一生心事向誰論",
      "十八灘頭說與君",
      "世事盡從流水去",
      "功名富貴等浮雲"
    ],
    "grade": "下下",
    "revid": 1496530,
    "title": "關聖帝君靈籤/20",
    "header": "==第20簽 下下 =="
  },
  {
    "number": 21,
    "lines": [
      "與君夙昔結成冤",
      "今日相逢那得緣",
      "好把經文多諷誦",
      "祈求戶內保嬋娟"
    ],
    "grade": "下下",
    "revid": 1496531,
    "title": "關聖帝君靈籤/21",
    "header": "==第21簽 下下 =="
  },
  {
    "number": 22,
    "lines": [
      "碧玉池中開白蓮",
      "莊嚴色相自天然",
      "生來骨格超凡俗",
      "正是人間第一仙"
    ],
    "grade": "上吉",
    "revid": 1496533,
    "title": "關聖帝君靈籤/22",
    "header": "==第22簽 上吉 =="
  },
  {
    "number": 23,
    "lines": [
      "花開花謝在春風",
      "貴賤窮通百歲中",
      "羨子榮華今已矣",
      "到頭萬事總成空"
    ],
    "grade": "下下",
    "revid": 1496534,
    "title": "關聖帝君靈籤/23",
    "header": "==第23簽 下下 =="
  },
  {
    "number": 24,
    "lines": [
      "一春萬事苦憂煎",
      "夏裏營求始帖然",
      "更遇秋成冬至後",
      "恰如騎鶴與腰纏"
    ],
    "grade": "中平",
    "revid": 1496535,
    "title": "關聖帝君靈籤/24",
    "header": "==第24簽 中平 =="
  },
  {
    "number": 25,
    "lines": [
      "寅午戍年多阻滯",
      "亥子丑月漸亨嘉",
      "更逢玉兔金雞會",
      "枯木逢春自放花"
    ],
    "grade": "中平",
    "revid": 1496536,
    "title": "關聖帝君靈籤/25",
    "header": "==第25簽 中平 =="
  },
  {
    "number": 26,
    "lines": [
      "年來豐歉皆天數",
      "自是今年旱較多",
      "與子定期三日內",
      "田疇霑足雨滂沱"
    ],
    "grade": "中吉",
    "revid": 1496537,
    "title": "關聖帝君靈籤/26",
    "header": "==第26簽 中吉 =="
  },
  {
    "number": 27,
    "lines": [
      "世間萬物各有主",
      "一粒一毫君莫取",
      "英雄豪傑自天生",
      "也須步步循規矩"
    ],
    "grade": "下下",
    "revid": 1496538,
    "title": "關聖帝君靈籤/27",
    "header": "==第27簽 下下 =="
  },
  {
    "number": 28,
    "lines": [
      "公侯將相本無種",
      "好把勤勞契上天",
      "人事盡從天理見",
      "才高豈得困林泉"
    ],
    "grade": "上吉",
    "revid": 1496539,
    "title": "關聖帝君靈籤/28",
    "header": "==第28簽 上吉 =="
  },
  {
    "number": 29,
    "lines": [
      "祖宗積德幾多年",
      "源遠流長慶自然",
      "若更操修無倦已",
      "天須還汝舊青氈"
    ],
    "grade": "上上",
    "revid": 1625654,
    "title": "關聖帝君靈籤/29",
    "header": "==第29簽 上上 =="
  },
  {
    "number": 30,
    "lines": [
      "奉公謹守莫欺心",
      "自有亨通吉利臨",
      "目下營求且休矣",
      "秋期與子定佳音"
    ],
    "grade": "中吉",
    "revid": 1496541,
    "title": "關聖帝君靈籤/30",
    "header": "==第30簽 中吉 =="
  },
  {
    "number": 31,
    "lines": [
      "秋冬作事只尋常",
      "春到門庭漸吉昌",
      "千里信音符遠望",
      "萱堂快樂未渠央"
    ],
    "grade": "中吉",
    "revid": 1496542,
    "title": "關聖帝君靈籤/31",
    "header": "==第31簽 中吉 =="
  },
  {
    "number": 32,
    "lines": [
      "勞心汨汨竟何歸",
      "疾病兼多是與非",
      "事到頭來渾似夢",
      "何如休要用心機"
    ],
    "grade": "下下",
    "revid": 1496543,
    "title": "關聖帝君靈籤/32",
    "header": "==第32簽 下下 =="
  },
  {
    "number": 33,
    "lines": [
      "不分南北與西東",
      "眼底昏昏耳似聾",
      "熟讀黃庭經一卷",
      "不論貴賤與窮通"
    ],
    "grade": "中平",
    "revid": 1496544,
    "title": "關聖帝君靈籤/33",
    "header": "==第33簽 中平 =="
  },
  {
    "number": 34,
    "lines": [
      "春夏纔過秋又冬",
      "紛紛謀慮攪心胸",
      "貴人垂手來相援",
      "休把私心情意濃"
    ],
    "grade": "中平",
    "revid": 1496545,
    "title": "關聖帝君靈籤/34",
    "header": "==第34簽 中平 =="
  },
  {
    "number": 35,
    "lines": [
      "一山如畫對清江",
      "門裏團圓事事雙",
      "誰料半途分折去",
      "空幃無語對銀缸"
    ],
    "grade": "下下",
    "revid": 1496546,
    "title": "關聖帝君靈籤/35",
    "header": "==第35簽 下下 =="
  },
  {
    "number": 36,
    "lines": [
      "功名富貴自能為",
      "偶著仙鞭莫問伊",
      "萬里鵬程君有分",
      "吳山頂上好鑽龜"
    ],
    "grade": "上吉",
    "revid": 1496548,
    "title": "關聖帝君靈籤/36",
    "header": "==第36簽 上吉 =="
  },
  {
    "number": 37,
    "lines": [
      "焚香來告復何辭",
      "善惡平分汝自知",
      "屏卻昧公心裏事",
      "出門無礙是通時"
    ],
    "grade": "中平",
    "revid": 1496549,
    "title": "關聖帝君靈籤/37",
    "header": "==第37簽 中平 =="
  },
  {
    "number": 38,
    "lines": [
      "蛩吟唧唧守孤幃",
      "千里懸懸望信歸",
      "等得榮華公子到",
      "秋冬括括雨靡靡"
    ],
    "grade": "下下",
    "revid": 1496550,
    "title": "關聖帝君靈籤/38",
    "header": "==第38簽 下下 =="
  },
  {
    "number": 39,
    "lines": [
      "北山門下好安居",
      "若問終時慎厥初",
      "堪笑包藏許多事",
      "鱗鴻雖便莫修書"
    ],
    "grade": "下下",
    "revid": 1496551,
    "title": "關聖帝君靈籤/39",
    "header": "==第39簽 下下 =="
  },
  {
    "number": 40,
    "lines": [
      "新來換得好規模",
      "何用隨他步與趨",
      "只聽耳邊消息到",
      "崎嶇歷盡見亨衢"
    ],
    "grade": "上吉",
    "revid": 1496552,
    "title": "關聖帝君靈籤/40",
    "header": "==第40簽 上吉 =="
  },
  {
    "number": 41,
    "lines": [
      "自南自北自東西",
      "欲到天涯誰作梯",
      "遇鼠逢牛三弄笛",
      "好將名姓榜頭題"
    ],
    "grade": "中吉",
    "revid": 1496553,
    "title": "關聖帝君靈籤/41",
    "header": "==第41簽 中吉 =="
  },
  {
    "number": 42,
    "lines": [
      "我曾許汝事和諧",
      "誰料修為汝自乖",
      "但改新圖莫依舊",
      "營謀應得稱心懷"
    ],
    "grade": "中吉",
    "revid": 1496554,
    "title": "關聖帝君靈籤/42",
    "header": "==第42簽 中吉 =="
  },
  {
    "number": 43,
    "lines": [
      "一紙官書火急催",
      "扁舟速下浪如雷",
      "雖然目下多驚險",
      "保汝平安去復回"
    ],
    "grade": "中吉",
    "revid": 1496555,
    "title": "關聖帝君靈籤/43",
    "header": "==第43簽 中吉 =="
  },
  {
    "number": 44,
    "lines": [
      "汝是人中最吉人",
      "誤為誤作損精神",
      "堅牢一念酬香願",
      "富貴榮華萃汝身"
    ],
    "grade": "中平",
    "revid": 1496556,
    "title": "關聖帝君靈籤/44",
    "header": "==第44簽 中平 =="
  },
  {
    "number": 45,
    "lines": [
      "好將心地力耕耘",
      "彼此山頭總是墳",
      "陰地不如心地好",
      "修為到底卻輸君"
    ],
    "grade": "中平",
    "revid": 1496557,
    "title": "關聖帝君靈籤/45",
    "header": "==第45簽 中平 =="
  },
  {
    "number": 46,
    "lines": [
      "君是山中萬戶侯",
      "信知騎馬勝騎牛",
      "今朝馬上看山色",
      "爭似騎牛得自由"
    ],
    "grade": "中平",
    "revid": 1496558,
    "title": "關聖帝君靈籤/46",
    "header": "==第46簽 中平 =="
  },
  {
    "number": 47,
    "lines": [
      "與君萬語復千言",
      "祗欲平和雪爾冤",
      "訟則終凶君記取",
      "試於清夜把心捫"
    ],
    "grade": "下下",
    "revid": 1496559,
    "title": "關聖帝君靈籤/47",
    "header": "==第47簽 下下 =="
  },
  {
    "number": 48,
    "lines": [
      "登山涉水正天寒",
      "兄弟姻親那得安",
      "幸遇虎頭人一喚",
      "全家遂保汝重歡"
    ],
    "grade": "中平",
    "revid": 1496560,
    "title": "關聖帝君靈籤/48",
    "header": "==第48簽 中平 =="
  },
  {
    "number": 49,
    "lines": [
      "彼此家居只一山",
      "如何似隔鬼門關",
      "日月如梭人易老",
      "許多勞碌不如閒"
    ],
    "grade": "下下",
    "revid": 1496561,
    "title": "關聖帝君靈籤/49",
    "header": "==第49簽 下下 =="
  },
  {
    "number": 50,
    "lines": [
      "人說今年勝舊年",
      "也須步多要周旋",
      "一家和氣多生福",
      "萋菲讒言莫聽偏"
    ],
    "grade": "上平",
    "revid": 1496562,
    "title": "關聖帝君靈籤/50",
    "header": "==第50簽 上平 =="
  },
  {
    "number": 51,
    "lines": [
      "君今百事且隨緣",
      "水到渠成聽自然",
      "莫嘆年來不如意",
      "喜逢新運稱心田"
    ],
    "grade": "上吉",
    "revid": 1496563,
    "title": "關聖帝君靈籤/51",
    "header": "==第51簽 上吉 =="
  },
  {
    "number": 52,
    "lines": [
      "兀坐幽居歎寂寥",
      "孤燈掩映度清宵",
      "萬金忽報秋光好",
      "活計扁舟渡北朝"
    ],
    "grade": "上吉",
    "revid": 1496564,
    "title": "關聖帝君靈籤/52",
    "header": "==第52簽 上吉 =="
  },
  {
    "number": 53,
    "lines": [
      "艱難險阻路蹊蹺",
      "南鳥孤飛依北巢",
      "今日貴人曾識面",
      "相逢卻在夏秋交"
    ],
    "grade": "下下",
    "revid": 1496565,
    "title": "關聖帝君靈籤/53",
    "header": "==第53簽 下下 =="
  },
  {
    "number": 54,
    "lines": [
      "萬人叢裏逞英豪",
      "便欲飛騰霄漢高",
      "爭奈承流風未便",
      "青燈黃卷且勤勞"
