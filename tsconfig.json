{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true,
    "noEmit": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "react"]
  },
  "include": ["src", "tests", "types"]
}
